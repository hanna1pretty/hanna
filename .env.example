# ─── BOT UTAMA ─────────────────────────────────────────────────────
BOT_TOKEN=123456789:ABCDEF_your_main_bot_token_here
API_ID=12345678
API_HASH=your_api_hash_here

# ─── BOT TAMBAHAN (opsional, bisa tambah BOT_TOKEN_3, dst) ────────
# BOT_TOKEN_2=987654321:ABCDEF_your_second_bot_token_here
# BOT_TOKEN_3=111111111:ABCDEF_your_third_bot_token_here

# ─── ADMIN ─────────────────────────────────────────────────────────
# Pisahkan dengan koma untuk multiple admin
ADMIN_ID=123456789

# ─── API PROVIDER ──────────────────────────────────────────────────
TOP_TOOLS_API_KEY=your_top_tools_api_key_here
BASE_URL=https://top-tools-ai.com/api/v1

# ─── TELEGRAM PROXY (opsional; kosong = koneksi langsung) ──────────
# Skema: socks5, socks4, atau http (HTTP CONNECT)
# PROXY_SCHEME=socks5
# PROXY_HOST=proxy.example.com
# PROXY_PORT=1080
# PROXY_USERNAME=your_proxy_username
# PROXY_PASSWORD=your_proxy_password

# ─── KREDIT ────────────────────────────────────────────────────────
INITIAL_CREDITS=220.00
DEFAULT_MODEL=top-tools-ai

# ─── KONFIGURASI ───────────────────────────────────────────────────
MAX_HISTORY=20
API_TIMEOUT=60
API_RETRIES=2
RETRY_DELAY=2.0
STREAM_UPDATE_INTERVAL=0.8
MAX_IMAGE_BYTES=10485760
MAX_PROMPT_LENGTH=4000
MAX_FILE_BYTES=5242880
MAX_EXTRACTED_CHARS=20000
PUBLIC_DAILY_REQUEST_LIMIT=40
PUBLIC_DAILY_TOKEN_LIMIT=100000

# ─── WEB RESEARCH ──────────────────────────────────────────────────
# Brave Search API key; kosong = fallback DuckDuckGo HTML terbatas
# WEB_SEARCH_API_KEY=your_brave_search_api_key_here
# WEB_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
WEB_SEARCH_RESULTS=5
WEB_FETCH_TIMEOUT=12
WEB_FETCH_MAX_BYTES=350000

# ─── SYSTEM PROMPT (opsional, custom personality bot) ──────────────
# SYSTEM_PROMPT=You are Hanna, a fast and helpful AI assistant.
